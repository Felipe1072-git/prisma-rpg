{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "prisma-docs",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "mkdocs", "serve", "--dev-addr", "127.0.0.1:8000"],
      "port": 8000
    },
    {
      "name": "prisma-docs-alt",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "mkdocs", "serve", "--dev-addr", "127.0.0.1:8011"],
      "port": 8011
    },
    {
      "name": "prisma-docs-alt2",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "mkdocs", "serve", "--dev-addr", "127.0.0.1:8023"],
      "port": 8023
    }
  ]
}
